# 配置同步接入端 的 systemd 服务配置。
# 部署前创建 middle-platform 低权限用户，并将可执行文件和 YAML 配置放到指定路径。
[Unit]
Description=Middle Platform config-center-access
Wants=network-online.target
After=network-online.target

# 进程失败时自动重启；收到 SIGTERM 后为请求处理和后台任务预留最多 40 秒。
[Service]
Type=simple
User=middle-platform
Group=middle-platform
WorkingDirectory=/opt/middle-platform/config-center-access
ExecStart=/opt/middle-platform/config-center-access/config-center-access -config /etc/middle-platform/config-center-access.yaml
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=40s

[Install]
WantedBy=multi-user.target
