# Nginx reverse-proxy example for a dedicated gateway host.
# Replace upstream IPs, domains, TLS certificate paths, admin CIDR, and htpasswd path.
# Both nodes must bind to private IPs; firewall must only allow this gateway to reach them.
# The admin container listens on :8281; gateway may listen on :80 on the same host if IP bindings permit.

# On each application host: sdk-core-1 = :8211, sdk-core-2 = :8212.
upstream mp_core {
    least_conn;
    server 10.0.0.11:8211 max_fails=3 fail_timeout=10s;
    server 10.0.0.11:8212 max_fails=3 fail_timeout=10s;
    server 10.0.0.12:8211 max_fails=3 fail_timeout=10s;
    server 10.0.0.12:8212 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

upstream mp_config {
    server 10.0.0.11:8201 max_fails=3 fail_timeout=10s;
    server 10.0.0.12:8201 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

upstream mp_admin {
    server 10.0.0.11:8281 max_fails=3 fail_timeout=10s;
    server 10.0.0.12:8281 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

server {
    listen 80;
    server_name api.example.com admin.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.example.com;
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Only expose the SDK-facing API publicly.
    location ^~ /api/core/ {
        proxy_pass http://mp_core;
    }

    # Configuration sync and all admin functions remain private.
    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # Replace with your actual VPN/private CIDR. Both IP ACL and Basic Auth apply.
    allow 10.0.0.0/24;
    deny all;
    auth_basic "Middle Platform Admin";
    auth_basic_user_file /etc/nginx/middle-platform.htpasswd;
    # Do not forward the admin Basic Auth credential to either Go or static upstream.
    proxy_set_header Authorization "";

    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location ^~ /api/config/ {
        proxy_pass http://mp_config;
    }

    location / {
        proxy_pass http://mp_admin;
    }
}
