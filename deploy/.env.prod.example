# Copy to /etc/middle-platform/compose.env on EACH application host.
# Use an immutable image tag published by the GitHub Actions workflow.
IMAGE_TAG=sha-REPLACE_WITH_40_CHARACTER_COMMIT_SHA

# Must be an IP assigned to the server's private/VPN interface.
# Use 127.0.0.1 only for a single-host deployment with local Nginx.
BIND_IP=10.0.0.11

# Absolute directory containing private YAML configuration files.
CONFIG_DIR=/etc/middle-platform
